# ─── Mini D-Mart API Environment Variables Configuration ─────────────────────
# Copy this file to application-local.properties or set these in your hosting environment (e.g. Render Dashboard)

# PostgreSQL Database (Neon Cloud / Local)
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-db-host>:5432/<dbname>?sslmode=require
SPRING_DATASOURCE_USERNAME=<db-username>
SPRING_DATASOURCE_PASSWORD=<db-password>

# JWT Authentication
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Server Port (Optional — defaults to 8081 locally, or PORT env var on Render)
PORT=8081
